07CD4"},{"label":"New covenant","color":"#E4DFCE"},{"label":"Unassigned","color":"#5A6178"}],"relkinds":[{"key":"quoted-in","label":"Quoted in","color":"#E8C15A","strong":true},{"key":"fulfilled-in","label":"Fulfilled in","color":"#D9715C","strong":true},{"key":"parallels","label":"Parallels","color":"#6E9BD1","strong":false},{"key":"illustrates-doctrine","label":"Illustrates doctrine","color":"#9B8AD1","strong":false},{"key":"part-of-covenant","label":"Part of covenant","color":"#5FBFA0","strong":false}],"counts":{"topics":4,"portals":0,"edges":3,"relations":0,"outbound":0},"nodes":[{"id":"bt_book_oba","p":0,"x":56,"y":109,"s":-1,"g":6,"bk":"OBA","ty":"BOOK_OVERVIEW","t":"Obadiah: overview","d":"The one-chapter vision of Obadiah against Edom: Edom's pride is brought down, its violence against brother Jacob is condemned, and the day of the LORD brings deliverance on Zion and a kingdom that is the LORD's.","q":"Can {{name}} say who Obadiah's vision is about and give its three parts?","ev":["Say who the vision is against (1:1)","Outline in three parts: pride (1-9), violence against Jacob (10-14), the day of the LORD (15-21)"],"pp":[[30,1,1,21]],"tier":null},{"id":"bt_oba_edom_pride_brought_down","p":0,"x":56,"y":239,"s":0,"g":6,"bk":"OBA","ty":"THEME","t":"Edom's pride brought down","d":"The LORD says he will make Edom small, bringing down the one who dwells in the clefts of the rock and says in his heart that none can bring him down; his allies deceive him and the wise men of Esau's mount are destroyed.","q":"Can {{name}} explain why Edom feels safe in Obadiah 1:3-4 and what the LORD says about it?","ev":["Say what deceived Edom (1:3)","Describe how far the LORD says he will bring Edom down (1:4)"],"pp":[[30,1,1,9]],"tier":null},{"id":"bt_oba_edom_violence_against_jacob","p":0,"x":244,"y":239,"s":0,"g":6,"bk":"OBA","ty":"THEME","t":"Edom's violence against his brother","d":"Edom is condemned for standing aloof while strangers took Jerusalem, and for rejoicing, entering the gate, looting and cutting off fugitives in the day of his brother Jacob's calamity.","q":"Can {{name}} list what Edom did in his brother's day of calamity according to Obadiah 1:10-14?","ev":["List what Edom should not have done (1:12-14)","Say what relationship the text names between Edom and Jacob (1:10)"],"pp":[[30,1,10,14]],"tier":null},{"id":"bt_oba_day_of_lord_kingdom","p":0,"x":56,"y":369,"s":1,"g":6,"bk":"OBA","ty":"THEME","t":"The day of the LORD and the kingdom","d":"The day of the LORD is near on all the nations, and as Edom has done it will be done to him; on Mount Zion there will be deliverance, the house of Jacob will possess their possessions, and the kingdom will be the LORD's.","q":"Can {{name}} explain what Obadiah 1:15-21 says will happen to Edom and to the house of Jacob?","ev":["Read the principle of 1:15","Contrast the end of Esau with Zion in 1:17-18","Read the closing line (1:21)"],"pp":[[30,1,15,21]],"tier":null}],"edges":[[1,0,0],[2,1,1],[3,2,1]],"rel":[]}
